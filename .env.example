# Safety controls
BOT_ENABLED=false
PAPER_TRADING=true
DRY_RUN=true
BOT_VERSION=local

# Trading cadence
TRADING_INTERVAL_MINUTES=10
POSITION_MANAGEMENT_ENABLED=false
# One-minute stop checks reduce threshold overshoot in volatile names.
POSITION_MANAGEMENT_INTERVAL_MINUTES=1
MARKET_TIMEZONE=America/New_York

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Alpaca Paper Trading
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Risk settings
MAX_POSITION_ALLOCATION_PERCENT=5
MAX_OPEN_POSITIONS=10
MAX_TOTAL_INVESTED_PERCENT=60
MIN_CONFIDENCE=0.70
ALLOWED_SYMBOLS=AAPL,MSFT,NVDA,SPY,QQQ 

# Dynamic watchlist scanner
DYNAMIC_WATCHLIST_ENABLED=false
BROAD_MARKET_SCAN_ENABLED=false
BROAD_MARKET_MAX_SYMBOLS=1000
MAX_SCANNER_CANDIDATES_AFTER_FILTERS=1000
ALPACA_DATA_FEED=iex
MAX_MARKET_DATA_AGE_SECONDS=180
# Every mechanical exit must use a fresh native Alpaca quote that agrees with the
# quote that triggered it. These guards prevent stale or inconsistent-price exits.
MAX_EXIT_QUOTE_AGE_SECONDS=15
MAX_EXIT_QUOTE_DEVIATION_PERCENT=0.5

# Reduce repeat trading after a full exit and avoid chasing extended momentum.
REENTRY_COOLDOWN_MINUTES=45
MAX_ENTRIES_PER_SYMBOL_PER_DAY=2
MAX_ENTRY_RSI=70
MAX_ENTRY_INTRADAY_MOVE_PERCENT=5
MIN_ENTRY_REWARD_RISK_RATIO=2
MARKET_REGIME_FILTER_ENABLED=true

# Reporting-only penalty for paper fills. This does not alter orders or broker balances.
PAPER_FILL_PENALTY_BPS=5
BROAD_SCAN_DATA_BATCH_SIZE=200
MIN_STOCK_PRICE=5
MIN_AVERAGE_VOLUME=500000
EXCLUDE_ETFS=true
WATCHLIST_SIZE=20
SCANNER_UNIVERSE=SPY,QQQ,AAPL,MSFT,NVDA,AMZN,GOOGL,META,TSLA,AMD,NFLX,AVGO,INTC,ORCL,CRM,ADBE,PYPL,UBER,SHOP,PLTR

# Discord notifications
DISCORD_WEBHOOK_URL=
DISCORD_DAILY_SUMMARY_ENABLED=false

# SQLite persistence
DATABASE_PATH=trading_bot.db

# Historical context
DECISION_HISTORY_LIMIT=20
EXECUTION_HISTORY_LIMIT=20
PORTFOLIO_HISTORY_LIMIT=20
INCLUDE_HISTORY_CONTEXT=true
